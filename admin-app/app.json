{
  "expo": {
    "name": "Admin Caipira",
    "slug": "admin-caipira",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "admincaipira",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.clubedejogoscaipira.admin",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#060912",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clubedejogoscaipira.admin",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2afaff35-6326-4b9e-8754-ca5aafb5fc66"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#060912"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#17c8ff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "brassz"
  }
}
